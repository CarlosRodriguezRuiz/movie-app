//- Persona 3. Gestión de películas del admin (MongoDB).
extends layout
include partials/movie-card


block content
  .page-header
    h1 Gestionar películas
    button#btn-new.btn(type="button") + Crear nueva

  //- Mismo formulario para crear y para editar (oculto por defecto).
  //- Lo envía admin-movies.js con fetch (POST para crear, PUT para editar).
   
  form#movie-form.form.panel(hidden novalidate)
    h2#form-title Crear o Editar película
    ul#form-errors.errors(hidden)
    .form-grid
      label Título *
        input(name="title" required)
      label URL de la imagen *
        input(name="poster" type="url" required placeholder="https://...")
      label Año *
        input(name="year" required type="number" placeholder="2024")
      label Director *
        input(name="director" required)
      label Género *
        input(name="genre" required placeholder="Comedia, Drama")
      label Duración *
        input(name="runtime" required placeholder="95 min")
      label Rating (0-10)
        input(name="rating" inputmode="decimal" placeholder="7,5")
      label Actores
        input(name="actors" placeholder="Actor 1, Actor 2")
      label Sinopsis
        textarea(name="plot" rows="3")
   

    .form-actions
      button.btn(type="submit") Guardar
      button#btn-cancel.btn.btn--secondary(type="button") Cancelar

  p.muted Aquí solo están las películas que NO existen en OMDB. Las de OMDB no se guardan en la base de datos.

  if !movies.length
    p.muted Todavía no hay películas. Crea la primera.

  .movie-grid
    each movie in movies
      +movieCard(movie)
        button.btn.btn--secondary.btn-edit(type="button" data-movie=JSON.stringify(movie)) Editar
        button.btn.btn--danger.btn-delete(type="button" data-id=movie.id) Eliminar

block scripts
  script(src="/js/admin-movies.js" defer)

