//- Persona 1. Vista de / y /login
extends layout

block content
  section.auth
    h1 Movie App
        //- Si el controlador manda un error, se enseña aquí
    if error
      p.alert= error
    form.form(action="/api/login" method="post")
      label(for="email") Email
      input#email(type="email" name="email" required value=form && form.email)
      label(for="password") Contraseña
      input#password(type="password" name="password" required)
      button.btn(type="submit") Entrar
    a.btn.btn--google(href="/auth/google") Entrar con Google
    p ¿No tienes cuenta? #[a(href="/signup") Regístrate]
