# Copia este archivo como .env y rellena tus valores. NUNCA subas el .env a GitHub.

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL (usuarios y favoritos) ---
PGHOST=localhost
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=movie_app

# --- MongoDB (películas creadas por el admin) ---
MONGO_URI=mongodb://127.0.0.1:27017/movie_app

# --- OMDB (http://www.omdbapi.com/apikey.aspx) ---
OMDB_API_KEY=

# --- JWT ---
JWT_SECRET=movie_app_bootcamp_carlos_2026_frase_larga_secreta
JWT_EXPIRES_IN=1h

# --- OAuth Google (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
